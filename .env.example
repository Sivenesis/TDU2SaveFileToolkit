# Test Drive Unlimited 2 Save File Toolkit Configuration
# Copy this file to .env to configure local environment settings

# Server Port
PORT=8282

# Optional: Custom path to TDU2 savegame folder or profile directory
# Defaults to %USERPROFILE%/Documents/Eden Games/Test Drive Unlimited 2/savegame
# TDU2_SAVEGAME_PATH=C:/Games/TDU2/savegame

# Synthetic Mock Credentials for Testing (No Real Credentials)
MOCK_ONLINE_LOGIN=player_12345
MOCK_ONLINE_EMAIL=user_12345@example.com
MOCK_ONLINE_PASSWORD=mock_password_placeholder
